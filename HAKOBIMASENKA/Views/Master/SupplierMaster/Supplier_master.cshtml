									</div>
								</div>
								<!-- Summary Row -->
								<div class="summary-row">
									<div class="summary-item">
										<label>前回買掛額</label>
										<input type="text">
									</div>
									<div class="summary-item">
										<label>今回支払額</label>
										<input type="text">
									</div>
									<div class="summary-item">
										<label>支払調整額</label>
										<input type="text">
									</div>

									<div class="summary-item">
										<label>今回繰越額</label>
										<input type="text" class="gray-field" readonly>
									</div>
									<div class="summary-item">
										<label>今回仕入額</label>
										<input type="text">
									</div>
									<div class="summary-item">
										<label>今回値引額</label>
										<input type="text">
									</div>
									<div class="summary-item">
										<label>今回消費税</label>
										<input type="text">
									</div>
									<div class="summary-item">
										<label>今回合計額</label>
										<input type="text" class="gray-field" readonly>
									</div>
									<div class="summary-item">
										<label>今回買掛額</label>
										<input type="text" class="gray-field" readonly>
									</div>
								</div>
								<!-- Action Buttons -->
								<div class="action-button-row">
									<button type="button">
										↓ 修　正
									</button>
									<button type="button">
										↑ 呼　出
									</button>
									<button type="button" disabled>
										削　除
									</button>
									<button type="button">
										中　止
									</button>
								</div>
								<!-- Grid -->
								<div class="history-grid-wrapper">
									<table class="history-grid">
										<thead>
											<tr>
												<th>開始日</th>
												<th>終了日</th>
												<th>前回買掛残</th>
												<th>今回支払額</th>
												<th>支払調整額</th>
												<th>今回繰越額</th>
												<th>今回仕入額</th>
												<th>今回値引額</th>
												<th>今回消費税</th>
												<th>今回合計額</th>
												<th>今回買掛額</th>
											</tr>
										</thead>
										<tbody>
										</tbody>
									</table>
								</div>
							</div>
						</section>

						<section id="digitacoSetting" class="tab-content">
							<div class="tab-row">
								<label>デジタコオプション設定</label>
								<input type="text" id="didgitaco">
							</div>
						</section>
					</section>
				</section>
			</main>
			<!-- Message Area -->
			<section class="message-area">
				<label>メッセージ：</label>
			</section>

			<!-- Footer Function Keys -->
			<footer class="function-footer">

				<button type="button" id="btnRegister">
					F1:登録
				</button>

				<button type="button" disabled>
					F2:コピー
				</button>

				<button type="button" disabled>
					F3:
				</button>

				<button type="button">
					F4:削　除
				</button>

				<button type="button">
					F5:検　索
				</button>

				<button type="button" id="btnMasterSearch" disabled>
					F6:マスタ検索
				</button>

				<button type="button">
					F7:≪　前
				</button>

				<button type="button">
					F8:次　≫
				</button>

				<button type="button" id="supplierMasterbtnList" onclick="openPrintPopup()">
					F9:リスト
				</button>

				<button type="button" disabled>
					F10:
				</button>

				<button type="button" id="btnCancel">
					F11:中止
				</button>

				<button type="button" id="btnExit">
					F12:終了
				</button>

