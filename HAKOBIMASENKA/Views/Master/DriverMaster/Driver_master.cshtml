@{
	ViewData["Title"] = "運転手マスタ";
}

@section Styles
{
	<link rel="stylesheet" href="~/css/driver_master.css" asp-append-version="true">
	@* <link rel="stylesheet" href="~/css/listscreen.css" asp-append-version="true" /> *@
	<link rel="stylesheet" href="~/css/japanesecalendar.css" asp-append-version="true" />
	@* search popups opened by F5 / F6 *@
	<link rel="stylesheet" href="~/css/master_search_css/driver_search.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/master_search_css/vehicle_search.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/master_search_css/chartered_search.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/master_search_css/department_search.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/master_search_css/expense_search.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/common.css" asp-append-version="true" />
}

<!-- Main window-->
<div class="main-container">
	@Html.AntiForgeryToken()
	@await Html.PartialAsync("~/Views/Controls/calendar_common.cshtml")
	<!-- Screen header-->
	<header class="page-header">
		<div class="screen-name">
			運転手マスタ
		</div>
		<label id="mode-lbl" class="lbl-new">新　規</label>
	</header>
	<section class="master-section">
		<div class="master-row">
			<label>
				運転手コード
			</label>
			<input type="text" id="driver-code" value="" class="master-input">
		</div>
		<div class="master-row">
			<label for="originCode">
				運転手名
			</label>
			<input id="driverName" type="text" value="" class="master-input">
		</div>
	</section>
	<main class="mainContent-layout">
		<!-- Editable Area(Left)-->
		<section class="edit-panel">
			<!--Tab1-->
			<nav class="tab-navigation">
				<button type="button" class="tab-button active" data-tab="basicSetting">
					基本設定
				</button>

				<button type="button" class="tab-button" data-tab="fixedCostSetting">
					固定経費設定
				</button>

				<button type="button" class="tab-button" data-tab="payrollOptionSettings">
					給与ｵﾌﾟｼｮﾝ設定
				</button>

				<button type="button" class="tab-button" data-tab="digitacoSetting">
					ﾃﾞｼﾞﾀｺｵﾌﾟｼｮﾝ設定
				</button>

				<button type="button" class="tab-button" data-tab="etcOptionSetting">
					ETCｵﾌﾟｼｮﾝ設定
				</button>

				<button type="button" class="tab-button" data-tab="driverLedger1">
					運転者台帳１
				</button>

				<button type="button" class="tab-button" data-tab="driverLedger2">
					運転者台帳２
				</button>

				<button type="button" class="tab-button" data-tab="driverLedger3">
					運転者台帳３
				</button>

				<button type="button" class="tab-button" data-tab="driverLedger4">
					運転者台帳４
				</button>
			</nav>
			<!--Tab details-->
			<section class="tab-container">
				<!--Basic settings-->
				<section id="basicSetting" class="tab-content active">
					<div class="tab-details">
						<div class="tab-row">
							<label for="furigana">
								フリガナ
							</label>
							<input type="text" id="furigana">
						</div>
						@* <div class="tab-row">
							<label for="abbreviation">
								略　称
							</label>
							<input type="text" id="abbreviation" class="short">
						</div> *@
						<div class="tab-row">
							<label for="zipCode">郵便番号</label>
							<div class="zipCode-row">
								<input type="text" id="zipCode" class="zip">
								<button type="button" id="zipCodeBtn1">
									〒→住所
								</button>
								<button type="button" id="zipCodeBtn2">
									住所→〒
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label id="address-label">住　所</label>
							<div class="address-block">
								<input type="text" id="addressField1">
								<input type="text" id="addressField2">
							</div>
						</div>
						<div class="tab-row">
							<label for="phoneNumber">電話番号</label>
							<input type="text" id="phoneNumber" class="short">
						</div>
						<div class="tab-row">
							<label for="mobilePhone">
								携帯電話
							</label>
							<input type="text" id="mobilePhone" class="short">
						</div>
						<div class="tab-row">
							<label for="dateOfBirth">生年月日</label>

							<input type="text" id="dateOfBirth" class="date-input jp-calendar-input" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日" />
						</div>
						<div class="tab-row">
							<label for="dateOfJoining">入　社　日</label>

							<input type="text" id="dateOfJoining" class="date-input jp-calendar-input" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日" />
						</div>
						<div class="tab-row">
							<label for="dateOfLeaving">退 社 日</label>

							<input type="text" id="dateOfLeaving" class="date-input jp-calendar-input" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日" />
						</div>
						<div class="tab-row">
							<label for="driverCategory">
								運転手区分
							</label>
							<div class="option-button-group">
								<input type="text" id="driverCategory" class="input-sl radBtnInpt">
								<button type="button" class="select-option-btn active" onclick="optionButton(this)">
									０：自　社
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									１：傭　車
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									２：契　約
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label>
								車　輌
							</label>
							<div>
								<input type="text" id="vehicle-code" @* class="input-sl" *@ value="">

								<select id="vehicle-name" class="master-name">
									<option value=""></option>
									@*@foreach (var unit in ViewBag.Units)
								{
									<option value="@unit.請求コード">
										@unit.請求名称
									</option>
								} *@
								</select>
							</div>
						</div>
						<div class="tab-row">
							<label>
								傭　車
							</label>
							<div>
								<input type="text" id="charteredVehicle-code" @* class="input-sl" *@ value="" disabled>

								<select id="charteredVehicle-name" class="master-name" disabled>
									<option value=""></option>
									@*@foreach (var unit in ViewBag.Units)
								{
									<option value="@unit.請求コード">
										@unit.請求名称
									</option>
								} *@
								</select>
							</div>
						</div>
						@*<div class="tab-row">
							<label for="email">EーMAIL</label>
							<input type="text" id="email">
						</div>*@
						<div class="master-row">
							<label>
								部　門
							</label>
							<input type="text" id="department-code" class="input-sl" value="">

							<input type="text" id="department-name" readonly="">
						</div>
						<div class="tab-row">
							<label for="remarks">摘要・備考</label>
							<input type="text" id="remarks">
						</div>
						<div class="tab-row">
							<label for="unitPrice-display" class="checkbox-lbl">配　車　表</label>
							<div class="checkbox-container">
								<input type="checkbox" id="unitPrice-display" class="input-checkbox">
								<label for="unitPrice-display">
									表示しない
								</label>
							</div>
						</div>
					</div>
				</section>
				<!-- 固定経費設定 Tab2 -->
				<section id="fixedCostSetting" class="tab-content">
					<div class="fixed-cost-layout">
						<!-- LEFT PANEL -->
						<section class="expense-entry-area">
							<div class="expense-form">

								<div class="expense-row">
									<label>経費項目</label>
									<input type="text" id="expenseitems" maxlength="4"
										   inputmode="numeric"
										   autocomplete="off"
										   oninput="this.value = this.value.replace(/[^0-9]/g, '')">
									<input type="text" class="master-name-expenseitems" readonly>
								</div>

								<div class="expense-row">
									<label>号　　車</label>
									<input type="text" id="exp-vehicle-code" maxlength="10" autocomplete="off">
									<input type="text" class="master-name-vehiclecode" readonly>
								</div>

								<div class="expense-row">
									<label>計上方法</label>
									<input type="text" class="small-code" id="accountingmethod" value="0" maxlength="1">
									<input type="text" class="master-name-accountingmethod" value="毎　月" readonly>
								</div>

								<div class="expense-row">
									<label>毎　　月</label>
									<input type="text" id="monthly" class="month-value-input">
								</div>

							</div>

							<!-- 月指定 -->
							<fieldset class="group-box-vehicle">
								<legend>月指定</legend>
								<div class="month-grid">
									<div class="month-row"><label>1月</label><input type="text" class="month-value-input" id="month1"></div>
									<div class="month-row"><label>5月</label><input type="text" class="month-value-input" id="month5"></div>
									<div class="month-row"><label>9月</label><input type="text" class="month-value-input" id="month9"></div>
									<div class="month-row"><label>2月</label><input type="text" class="month-value-input" id="month2"></div>
									<div class="month-row"><label>6月</label><input type="text" class="month-value-input" id="month6"></div>
									<div class="month-row"><label>10月</label><input type="text" class="month-value-input" id="month10"></div>
									<div class="month-row"><label>3月</label><input type="text" class="month-value-input" id="month3"></div>
									<div class="month-row"><label>7月</label><input type="text" class="month-value-input" id="month7"></div>
									<div class="month-row"><label>11月</label><input type="text" class="month-value-input" id="month11"></div>
									<div class="month-row"><label>4月</label><input type="text" class="month-value-input" id="month4"></div>
									<div class="month-row"><label>8月</label><input type="text" class="month-value-input" id="month8"></div>
									<div class="month-row"><label>12月</label><input type="text" class="month-value-input" id="month12"></div>
								</div>
								<div class="expense-total">
									<label>合計</label>
									<input type="text" id="monthlyTotal" style="text-align: right;" readonly>
								</div>
							</fieldset>

							<div class="expense-actions">
								<button type="button" id="btnExpenseDelete">削　除</button>
								<button type="button" id="btnExpenseCancel">中　止</button>
								<button type="button" id="btnExpenseRecall">←呼　出</button>
								<button type="button" id="btnExpenseModify">→修　正</button>
							</div>
						</section>

						<!-- RIGHT GRID -->
						<aside class="expense-list">
							<table class="expense-table" data-grid-columns>
								<thead>
									<tr>
										<th>経費ｺｰﾄﾞ</th>
										<th>経費項目</th>
										<th>号車ｺｰﾄﾞ</th>
										<th>号車</th>
										<th>計上方法</th>
										<th>経費</th>
									</tr>
								</thead>
								<tbody id="expenseTableBody">
									<!-- Rows will be added by JavaScript. -->
								</tbody>
							</table>
						</aside>
					</div>
				</section>
				<!-- 給与オプション設定 Tab3 -->
				<section id="payrollOptionSettings" class="tab-content">
					<div class="tab-row">
						<label>手当掛率</label>
						<div>
							<input type="text" value="100.00" id="payrollOptInp" class="decimal-input" data-int-digits="3" data-dec-digits="2" data-max-value="100.00">
							<span id="percentage" class="input-span">％</span>
						</div>
					</div>
					<div class="tab-row">
						<label>所属コード</label>
						<div class="affilation-row">
							<input type="text" id="affilation-code" class="master-code">

							<input type="text" id="affilation-name" class="master-name" readonly="">
						</div>
					</div>
					<div class="tab-row">
						<label for="employeementCategory">
							雇用区分
						</label>
						<div class="option-button-group">
							<input type="text" id="employeementCategory" class="input-sl radBtnInpt">
							<button type="button" class="select-option-btn active" onclick="optionButton(this)">
								0：正社員
							</button>
							<button type="button" class="select-option-btn" onclick="optionButton(this)">
								1：契約社員
							</button>
							<button type="button" class="select-option-btn" onclick="optionButton(this)">
								2：パート
							</button>
							<button type="button" class="select-option-btn" onclick="optionButton(this)">
								3：試用期間
							</button>
							<button type="button" class="select-option-btn" onclick="optionButton(this)">
								4：臨時ﾊﾞｲﾄ
							</button>
							<button type="button" class="select-option-btn" onclick="optionButton(this)">
								5：派　遣
							</button>
							<button type="button" class="select-option-btn" onclick="optionButton(this)">
								6：その他
							</button>
						</div>
					</div>
					<div class="tab-row">
						<label>所定労働日数</label>
						<div>
							@* legacy TxtShotei: Format "#0.0", 0.0-99.9, default 23 *@
							<input type="text" value="23.0" id="scheduled-working-days" class="decimal-input" data-int-digits="2" data-dec-digits="1" data-max-value="99.9">
							<span id="day" class="input-span">日</span>
						</div>
					</div>

				</section>
				<section id="digitacoSetting" class="tab-content">
					<div class="tab-row">
						<label>デジタココード</label>
						<input type="text" id="digitaco">
					</div>
				</section>
				<section id="etcOptionSetting" class="tab-content">
					<div class="tab-row">
						<label>カード番号</label>
						<input type="text" id="etcOptSetting">
					</div>
				</section>
				<!-- 運転者台帳１ (legacy SSActiveTabPanel8) -->
				<section id="driverLedger1" class="tab-content">

					<div class="driver-ledger-layout">

						<!-- Left Area -->
						<div class="ledger-left-area">

							<!-- Gender / Dates -->
							<div class="ledger-top-grid">

								<div class="ledger-row">
									<label class="ledger-label">性　別</label>

									<div class="gender-group">

										@* legacy TxtNKbn2 (1 digit) and LblNKbn2(1-2) *@
										<input type="text" id="genderCode" class="ledger-code" value="1">

										<button type="button" class="ledger-option-btn active" data-value="1">
											1：男
										</button>

										<button type="button" class="ledger-option-btn" data-value="2">
											2：女
										</button>

									</div>
								</div>

								<div class="ledger-row">
									<label class="ledger-label">選任年月日</label>
									<input type="text"
										   id="appointmentDate"
										   class="ledger-date jp-calendar-input">
								</div>

								<div class="ledger-row">
									<label class="ledger-label">写真撮影日</label>
									<input type="text"
										   id="photoDate"
										   class="ledger-date jp-calendar-input">
								</div>

								<div class="ledger-row">
									<label class="ledger-label">ファイル名</label>

									<div class="file-select-row">

										<input type="text"
											   id="photoFile">

										<button type="button"
												id="photoBrowseBtn"
												class="browse-btn"
												tabindex="-1">
											...
										</button>

									</div>
								</div>

								<div class="ledger-row">
									<label class="ledger-label">免許証番号</label>
									<input type="text" id="licenseNumber">
								</div>

								<div class="ledger-row">
									<label class="ledger-label">取得年月日</label>

									<input type="text"
										   id="licenseIssueDate"
										   class="ledger-date jp-calendar-input">
								</div>

							</div>

							<!-- License Types (legacy ChkS(0-16), no tab stop) -->
							<div class="license-type-section">

								<div class="license-type-label">
									種　類
								</div>

								<div class="license-type-grid">

									<label><input type="checkbox" class="ledger-check" data-column="大型" tabindex="-1"> 大 型</label>
									<label><input type="checkbox" class="ledger-check" data-column="中型" tabindex="-1"> 中 型</label>
									<label><input type="checkbox" class="ledger-check" data-column="中型限定" tabindex="-1"> 中型(8t限定)</label>
									<label><input type="checkbox" class="ledger-check" data-column="準中型" tabindex="-1"> 準中型</label>
									<label><input type="checkbox" class="ledger-check" data-column="普通" tabindex="-1"> 普 通</label>
									<label><input type="checkbox" class="ledger-check" data-column="大特" tabindex="-1"> 大 特</label>

									<label><input type="checkbox" class="ledger-check" data-column="大2" tabindex="-1"> 大 ２</label>
									<label><input type="checkbox" class="ledger-check" data-column="中2" tabindex="-1"> 中 ２</label>
									<label><input type="checkbox" class="ledger-check" data-column="中2限定" tabindex="-1"> 中２(8t限定)</label>
									<label><input type="checkbox" class="ledger-check" data-column="準中型限定" tabindex="-1"> 準中型(5t限定)</label>
									<label><input type="checkbox" class="ledger-check" data-column="普2" tabindex="-1"> 普 ２</label>
									<label><input type="checkbox" class="ledger-check" data-column="大特2" tabindex="-1"> 大特２</label>

									<label><input type="checkbox" class="ledger-check" data-column="ユニック" tabindex="-1"> ユニック</label>
									<label><input type="checkbox" class="ledger-check" data-column="玉掛け" tabindex="-1"> 玉掛け</label>
									<label><input type="checkbox" class="ledger-check" data-column="フォーク" tabindex="-1"> フォーク</label>
									<label><input type="checkbox" class="ledger-check" data-column="けん引" tabindex="-1"> けん引</label>
									<label><input type="checkbox" class="ledger-check" data-column="けん引2" tabindex="-1"> けん引２</label>

								</div>

							</div>

							<!-- Conditions -->
							<div class="ledger-row" id="l_Condition">
								<label class="ledger-label">条　件</label>
								<input type="text" id="licenseCondition">
							</div>

							<!-- License History (legacy GroupBox5 運転免許履歴 / MSFlxGrd2) -->
							<div class="license-history-section">

								<div class="history-title">
									運転免許履歴
								</div>

								<div class="history-entry">

									<label>有効期限</label>

									<input type="text"
										   id="licenseExpiry"
										   class="ledger-date jp-calendar-input">

									<span>まで</span>

									<label>番　号</label>

									<input type="text"
										   id="licenseHistoryNo">

								</div>

								<div class="history-buttons">

									<button type="button" id="btnLicensePrint">印　刷</button>
									<button type="button" id="btnLicenseDelete">削　除</button>
									<button type="button" id="btnLicenseCancel">中　止</button>
									<button type="button" id="btnLicenseRecall">↑ 呼 出</button>
									<button type="button" id="btnLicenseModify">↓ 修 正</button>

								</div>

								<table class="license-history-grid" data-grid-columns>

									<thead>
										<tr>
											<th>有効期限</th>
											<th>番号</th>
										</tr>
									</thead>

									<tbody id="licenseHistoryBody">
									</tbody>

								</table>

								<div class="driver-experience-section">

									<!-- Left Area (legacy TxtNDate(1-5) / TxtNEtc(1-5)) -->
									<div class="experience-left">

										<div class="experience-side-title">
											履歴・運転経験
										</div>

										<div class="experience-history-grid">

											<div class="experience-row">
												<input type="text" class="ledger-date jp-calendar-input" id="experienceDate1">
												<input type="text" id="experienceText1">
											</div>

											<div class="experience-row">
												<input type="text" class="ledger-date jp-calendar-input" id="experienceDate2">
												<input type="text" id="experienceText2">
											</div>

											<div class="experience-row">
												<input type="text" class="ledger-date jp-calendar-input" id="experienceDate3">
												<input type="text" id="experienceText3">
											</div>

											<div class="experience-row">
												<input type="text" class="ledger-date jp-calendar-input" id="experienceDate4">
												<input type="text" id="experienceText4">
											</div>

											<div class="experience-row">
												<input type="text" class="ledger-date jp-calendar-input" id="experienceDate5">
												<input type="text" id="experienceText5">
											</div>

										</div>

									</div>

									<!-- Right Area -->
									<div class="experience-right">

										<div class="experience-info-row">

											<div class="experience-label">
												自動車の種類
											</div>

											<div class="experience-input-group">
												<input type="text" id="vehicleType1">
												<input type="text" id="vehicleType2">
											</div>

										</div>

										<div class="experience-info-row">

											<div class="experience-label">
												定員又は積載量
											</div>

											<div class="experience-unit-area">

