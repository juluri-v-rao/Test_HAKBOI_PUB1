		<button type="button" id="btnList" disabled>
			F9:リスト
		</button>

		@* F10 運転者台帳 print (legacy Prt_List); off when opened from a search *@
		<button type="button" id="btnF10" @(ViewBag.FromSearch == true ? "disabled" : "")>
			F10:台 帳
		</button>

		<button type="button" id="btnCancel">
			F11:中 止
		</button>

		<button type="button" id="btnExit" data-exit-url="@Url.Action("Main_menu", "MainMenu")"
				data-from-search="@(ViewBag.FromSearch == true ? "true" : "false")">
			F12:終 了
		</button>

	</footer>
</div>

