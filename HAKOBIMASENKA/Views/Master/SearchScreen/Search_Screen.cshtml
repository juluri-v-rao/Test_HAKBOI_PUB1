<style>
    .search-test-screen {
        padding: 10px;
        min-height: 90vh;
        background: #dcdcdc;
    }

    .search-test-header {
        padding: 8px 12px;
        margin-bottom: 12px;
        background: #444;
        color: white;
        font-weight: bold;
    }

    .search-test-buttons {
        display: grid;
        grid-template-columns: repeat(3, minmax(150px, 240px));
        gap: 8px;
    }

        .search-test-buttons button {
            min-height: 42px;
            border: 1px solid #999;
            background: #eee;
            font-size: 14px;
            cursor: pointer;
        }

            .search-test-buttons button:hover {
                background: #ccc;
            }


    /* Dummy Master Registration Overlay */
    .dummy-master-overlay {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.4);
    }

    /* Dummy window */
    .dummy-master-window {
        width: min(1100px, 95vw);
        height: min(750px, 90vh);
        min-height: 600px;
        background: #dcdcdc;
        border: 1px solid #888;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
        overflow: auto;
    }

    /* Title bar */
    .dummy-master-titlebar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 32px;
        padding-left: 10px;
        background: #c5c5c5;
        color: #222;
        font-weight: bold;
    }

    /* Close button at top-right */
    .dummy-master-close {
        width: 38px;
        height: 32px;
        border: none;
        background: transparent;
        color: #333;
        font-size: 22px;
        cursor: pointer;
    }

        .dummy-master-close:hover {
            background: #e81123;
            color: white;
        }

    /* Message area */
    .dummy-master-message {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 185px;
        padding: 20px;
        text-align: center;
        font-size: 16px;
        font-weight: bold;
    }

</style>




<script>
        document.addEventListener("DOMContentLoaded", function () {

            // Map each test button to its existing search popup event.
            const searchPopupEvents = {
                shipper: "openShipperSearchPopup",
                chartered: "openCharteredSearchPopup",
                   orderSearch: "openOrderSearchPopup",
                   DriverSearch: "driverSearchPopup",
                   VehicleSearch: "vehicleSearchPopup",
                productName: "openProductNameSearchPopup",
                area: "openAreaSearchPopup",
                productClassification: "openProductClassificationSearchPopup",
                unit: "openUnitSearchPopup",
                transportationRecord: "openTransportationRecordSearchPopup",
                department: "openDepartmentSearchPopup",
                expense: "openExpenseSearchPopup",
                companyBranch: "openCompanyBranchSearchPopup",
                originDestination: "openOriginDestinationSearchPopup"
            };

            // Open the corresponding popup when a test button is clicked.
            document.querySelectorAll("[data-search]").forEach(function (button) {
                button.addEventListener("click", function () {
                    const searchType = this.dataset.search;
                    const eventName = searchPopupEvents[searchType];

                    if (!eventName) {
                        console.warn("No popup event configured for:", searchType);
                        return;
                    }

                    document.dispatchEvent(new CustomEvent(eventName));
                });
            });

            // F12:終了 - Return to Main Menu.
            const btnExit = document.getElementById("btnExit_F12");

            if (btnExit) {
                btnExit.addEventListener("click", function () {
                    const exitUrl = this.dataset.exitUrl;

                    if (exitUrl) {
                        window.location.href = exitUrl;
                    }
                });
            }


            // Dummy Master Registration screen.
            const dummyMasterModal =
                document.getElementById("dummyMasterModal");

            const btnCloseDummyMaster =
                document.getElementById("btnCloseDummyMaster");

            // Close the dummy screen using the top-right button.
            btnCloseDummyMaster?.addEventListener("click", function () {
                if (dummyMasterModal) {
                    dummyMasterModal.style.display = "none";
                }
            });

               // Receive the request to open the dummy registration screen.
        window.addEventListener("message", function (event) {
            if (event.origin !== window.location.origin) {
                return;
            }

            if (event.data?.action === "openDummyMasterRegistration") {
                if (!dummyMasterModal) {
                    return;
                }

                // Move the modal directly under body to avoid parent stacking contexts.
                document.body.appendChild(dummyMasterModal);

                // Display it above the search popup.
                dummyMasterModal.style.position = "fixed";
                dummyMasterModal.style.inset = "0";
                dummyMasterModal.style.zIndex = "2147483647";
                dummyMasterModal.style.display = "flex";
            }
        });
    });


</script>
