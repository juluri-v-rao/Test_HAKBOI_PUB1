<div class="search-test-screen">
    <header class="search-test-header">
        <span>検索画面 Search Screens</span>
    </header>

    <div class="search-test-buttons">
        <button type="button" data-search="shipper">荷主検索</button>
        <button type="button" data-search="chartered">傭車検索</button> 
        <button type="button" data-search="productClassification">品名区分検索</button>
        <button type="button" data-search="transportationRecord">輸送実績区分検索</button>
        <button type="button" data-search="area">エリア検索</button>
        <button type="button" data-search="unit">単位検索</button>
        <button type="button" data-search="originDestination">発着地検索</button>
        <button type="button" data-search="productName">品名検索</button>
        <button type="button" data-search="companyBranch">自社支店検索</button>
        <button type="button" data-search="orderSearch">受注検索</button>
        <button type="button" data-search="DriverSearch">運転手検索</button>
        <button type="button" data-search="VehicleSearch">車輌検索</button>

        <br />

        <div>
            <button type="button"
                    id="btnExit_F12"
                    data-exit-url="@Url.Action("Main_menu", "MainMenu")">
                Close　:　終了
            </button>
        </div>
    </div>
</div>

<!-- Dummy Master Registration Screen -->
<div id="dummyMasterModal" class="dummy-master-overlay" style="display: none;">
    <div class="dummy-master-window">

        <!-- Title bar -->
        <header class="dummy-master-titlebar">
            <span>マスタ登録 / Master Registration</span>

            <button type="button"
                    id="btnCloseDummyMaster"
                    class="dummy-master-close"
                    aria-label="Close">
                ×
            </button>
        </header>

        <!-- Message -->
        <div class="dummy-master-message">
            <p>Master Registration/Search still not implemented.</p>
            <p>マスタ登録／検索 機能はまだ実装されていません。</p>
        </div>

    </div>
</div>


