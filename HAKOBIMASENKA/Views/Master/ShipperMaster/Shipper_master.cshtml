@{
	ViewData["Title"] = "荷主マスタ";
}

<link rel="stylesheet" href="~/css/shipper_master.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/listscreen.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/japanesecalendar.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/common.css" asp-append-version="true">

<!-- Main window-->
<div class="main-container">

	@await Html.PartialAsync("~/Views/Controls/calendar_common.cshtml")

	<!-- Screen header-->
	<header class="page-header">
		<div class="screen-name">
			荷主マスタ
		</div>
		<label id="mode-lbl" class="lbl-new">新　規</label>
	</header>
	<section class="master-section">
		<div class="master-row">
			<label>
				コード
			</label>
			<input type="text" id="shipper-code" value="@ViewBag.NextCode" class="master-input">
		</div>
		<div class="master-row">
			<label>
				荷主名(1)
			</label>
			<input id="shipperName1" type="text" value="" class="master-input">
		</div>
		<div class="master-row">
			<label>
				荷主名(2)
			</label>
			<input id="shipperName2" type="text" value="" class="master-input">
		</div>
	</section>
	<main class="mainContent-layout">
		<!-- Editable Area(Left)-->
		<section class="edit-panel">
			<!--Tab1-->
			<nav class="tab-navigation">
				<button type="button" class="tab-button active" data-tab="basicSetting">
					基本設定
				</button>

				<button type="button" class="tab-button" data-tab="billingSetting">
					請求設定
				</button>

				<button type="button" class="tab-button" data-tab="calculationSetting">
					計算設定
				</button>

				<button type="button" class="tab-button" data-tab="billingHistory">
					請求履歴
				</button>

				<button type="button" class="tab-button" data-tab="accountsReceivableHistory">
					売掛履歴
				</button>

				<button type="button" class="tab-button" data-tab="payrollOptionSettings">
					給与ｵﾌﾟｼｮﾝ設定
				</button>

				<button type="button" class="tab-button" data-tab="digitacoSetting">
					ﾃﾞｼﾞﾀｺｵﾌﾟｼｮﾝ設定
				</button>
			</nav>
			<!--Tab details-->
			<section class="tab-container">
				<!--Basic settings-->
				<section id="basicSetting" class="tab-content active">
					<div class="tab-details">
						<div class="tab-row">
							<label>
								フリガナ
							</label>
							<input type="text" id="furigana">
						</div>
						<div class="tab-row">
							<label>
								略　　称
							</label>
							<input type="text" id="abbreviation" class="short">
						</div>
						<div class="tab-row">
							<label>郵便番号</label>
							<div class="zipCode-row">
								<input type="text" id="zipCode" class="zip">
								<button type="button" id="zipCodeBtn1">
									〒→住所
								</button>
								<button type="button" id="zipCodeBtn2">
									住所→〒
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label id="address-label">住　　所</label>
							<div class="address-block">
								<input type="text" id="addressField1">
								<input type="text" id="addressField2">
							</div>
						</div>
						<div class="tab-row">
							<label>電話番号</label>
							<input type="text" id="phoneNumber" class="short">
						</div>
						<div class="tab-row">
							<label>
								Ｆ Ａ Ｘ
							</label>
							<input type="text" id="fax" class="short">
						</div>
						<div class="tab-row">
							<label>取引開始日</label>

							<input type="text" id="startDate" class="date-input jp-calendar-input first-year-display" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日" />
						</div>
						<div class="tab-row">
							<label>取引終了日</label>

							<input type="text" id="endDate" class="date-input jp-calendar-input first-year-display" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日" />
						</div>
						<div class="tab-row">
							<label>摘要・備考</label>
							<input type="text" id="remarks">
						</div>
						<div class="tab-row">
							<label>E-Mail</label>
							<input type="text" id="email">
						</div>
						<div class="master-row">
							<label>
								部　　門
							</label>
							<input type="text" id="department-code" class="input-sl" value="">

							<input type="text" id="department-name" readonly="">
						</div>
					</div>
				</section>
				<!--Billing settings-->
				<section id="billingSetting" class="tab-content">
					<div class="tab-details">
						<div class="tab-row">
							<label>
								締 め 日
							</label>
							<div class="payment-closeDate">
								<input type="text" id="closingDate" class="input-sl">
								<span id="close-date" class="input-span">日締め</span>
							</div>
						</div>
						<div class="tab-row">
							<label>
								請 求 先
							</label>
							<div class="payment-settlementReceipt">
								<input type="text" id="settlementReceipt" class="master-code">
								<input type="text" id="shipper-name" class="master-name" readonly>
							</div>
						</div>
						<div class="tab-row">
							<label>
								請求区分
							</label>
							<div>
								<input type="text" id="unit-code" class="input-sl" value="">

								<select id="unit-name" tabindex="-1">
									<option value=""></option>
									@foreach (var unit in ViewBag.Units)
									{
										<option value="@unit.請求コード">
											@unit.請求名称
										</option>
									}
								</select>
							</div>
						</div>
						<div class="tab-row">
							<label>
								回収サイト
							</label>
							<div class="collection-cycle">
								<input type="text" id="collectionTerms" class="input-sl">
								<span id="collectionCycle" class="input-span">[0:当月 1:翌月 2:翌々月 9:9ヶ月後]</span>
							</div>
						</div>
						<div class="tab-row">
							<label>
								回 収 日
							</label>
							<div class="collection-date">
								<input type="text" id="collectionDate" class="input-sl">
								<span id="collectiondt" class="input-span">[末日:31]</span>
							</div>
						</div>
						<div class="tab-row">
							<label>
								回収方法1
							</label>
							<div>
								<input type="text" id="collectionMethod1-code" class="input-sl">
								<select id="collectionMethod1-name" class="master-name" tabindex="-1">
									<option value=""></option>
									@foreach (var item in ViewBag.PaymentCategories)
									{
										<option value="@item.入金区分コード">
											@item.入金区分名称
										</option>
									}
								</select>
							</div>
						</div>
						<div class="tab-row">
							<label>回収条件</label>
							<input type="text" id="collectionCondition">
						</div>
						<div class="tab-row">
							<label>
								回収方法2
							</label>
							<div>
								<input type="text" id="collectionMethod2-code" class="input-sl">
								<select id="collectionMethod2-name" class="master-name" tabindex="-1">
									<option value=""></option>
									@foreach (var item in ViewBag.PaymentCategories)
									{
										<option value="@item.入金区分コード">
											@item.入金区分名称
										</option>
									}
								</select>
							</div>
						</div>
						<div class="tab-row">
							<label>銀行コード</label>
							<input type="text" id="bankCode">
						</div>
						<div class="tab-row">
							<label>銀行(1)</label>
							<input type="text" id="bankName1" readonly>
						</div>
						<div class="tab-row">
							<label>銀行(2)</label>
							<input type="text" id="bankName2" readonly>
						</div>
					</div>
				</section>
				<!--Calculation settings-->
				<section id="calculationSetting" class="tab-content">
					<div class="tab-details">
						<div class="tab-row">
							<label>
								端数桁数
							</label>
							<div class="option-button-group">
								<input type="text" id="decimal-places-num" class="input-sl radBtnInpt">
								<button type="button" class="select-option-btn active" onclick="optionButton(this)">
									0：1円未満
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									1：10円未満
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									2：100円未満
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label>
								売上端数
							</label>
							<div class="option-button-group">
								<input type="text" id="salesFractionAmt-input" class="input-sl radBtnInpt">
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									０：切り捨て
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									１：四捨五入
								</button>
								<button type="button" class="select-option-btn active" onclick="optionButton(this)">
									２：切り上げ
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label>
								消費税区分
							</label>
							<div class="option-button-group">
								<input type="text" id="consumptionTaxCategory-input" class="input-sl radBtnInpt">
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									０：請 求 毎
								</button>
								<button type="button" class="select-option-btn active" onclick="optionButton(this)">
									１：明 細 毎
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									２：非 課 税
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label>
								消費税端数
							</label>
							<div class="option-button-group">
								<input type="text" id="consumptionTaxFraction-input" class="input-sl radBtnInpt">
								<button type="button" class="select-option-btn active" onclick="optionButton(this)">
									０：切り捨て
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									１：四捨五入
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									２：切り上げ
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label>
								値 引 率
							</label>
							<div class="discountRate-input">
								<input type="text" id="discount-rate" placeholder="0.00" class="decimal-input" data-int-digits="3" data-dec-digits="2" data-max-value="100.00">
								<span id="percent" class="input-span">%</span>
							</div>
						</div>
						<div class="tab-row">
							<label>
								課税割増
							</label>
							<div class="option-button-group">
								<input type="text" id="taxableSurcharge-input" class="input-sl radBtnInpt">
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									０：値引対象内
								</button>
								<button type="button" class="select-option-btn active" onclick="optionButton(this)">
									１：値引対象外
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label>
								非課税割増
							</label>
							<div class="option-button-group">
								<input type="text" id="nonTaxableSurcharge-input" class="input-sl radBtnInpt">
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									０：値引対象内
								</button>
								<button type="button" class="select-option-btn active" onclick="optionButton(this)">
									１：値引対象外
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label>
								値引端数
							</label>
							<div class="option-button-group">
								<input type="text" id="discountFraction-input" class="input-sl radBtnInpt">
								<button type="button" class="select-option-btn active" onclick="optionButton(this)">
									０：切り捨て
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									１：四捨五入
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									２：切り上げ
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label>
								請求日設定
							</label>
							<div class="option-button-group">
								<input type="text" id="billingDateSetting-input" class="input-sl radBtnInpt">
								<button type="button" class="select-option-btn active" onclick="optionButton(this)">
									0：運 行 日
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									1：積　　日
								</button>
								<button type="button" class="select-option-btn" onclick="optionButton(this)">
									2：卸　　日
								</button>
							</div>
						</div>
						<div class="tab-row">
							<label>
								数量小数点
							</label>
							<div class="quantityDecimal-input">
								<input type="text" id="quantityDecimalPlaces" class="input-sl radBtnInpt">
								<span id="digit1" class="input-span">桁</span>
							</div>
						</div>
						<div class="tab-row">
							<label>
								重量小数点
							</label>
							<div class="weightDecimal-input">
								<input type="text" id="weightDecimalPlaces" class="input-sl radBtnInpt">
								<span id="digit2" class="input-span">桁</span>
							</div>
						</div>
						<div class="tab-row">
							<label>
								単価小数点
							</label>
							<div class="unitPriceDecimal-input">
								<input type="text" id="unitPriceDecimalPlaces" class="input-sl radBtnInpt">
								<span id="digit3" class="input-span">桁</span>
							</div>
						</div>
						<div class="tab-row">
							<label class="checkbox-lbl">単価表示</label>
							<div class="checkbox-container">
								<input type="checkbox" id="unitPrice-display" class="input-checkbox">
								<label>
									表示しない
								</label>
							</div>
						</div>
						<div class="tab-row">
							<label class="checkbox-lbl">請求残計算</label>
							<div class="checkbox-container">
								<input type="checkbox" id="billingBal-Calculation" class="input-checkbox">
								<label>計算しない</label>
							</div>
						</div>
						<div class="tab-row">
							<label class="checkbox-lbl">売掛残計算</label>
							<div class="checkbox-container">
								<input type="checkbox" id="accReceivableBalCalculation" class="input-checkbox">
								<label>計算しない</label>
							</div>
						</div>
					</div>
				</section>
				<!--Billing History Tab-->
				<section id="billingHistory" class="tab-content">
					<div id="bill_HistoryDetails" class="tab-details history-tab">
						<div class="branchTarget-header-row">
							<div class="master-row branch">
								<label>
									自社支店
								</label>
								<input type="text" id="branch-code1" class="input-sl" value="01">

								<input type="text" id="billing-branch-name" value=@ViewBag.BranchName readonly="">
							</div>
							<div class="history-top-area">
								<div class="period-row">
									<label class="period-label">対象期間</label>
									<input type="text" id="fromDate_bill" class="date-input jp-calendar-input first-year-display" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日" />
									<span class="between-date">～</span>
									<input type="text" id="toDate_bill" class="date-input jp-calendar-input first-year-display" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日">
								</div>
							</div>
						</div>
						<div class="billing-summary-layout">

							<div class="summary-column">
								<label>前回請求額</label>
								<input type="text" id="bh-previous-billing" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
							</div>

							<div class="summary-double-column">

								<label>今回入金額</label>
								<label>入金調整額</label>
								<input type="text" id="bh-payment-amount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
								<input type="text" id="bh-adjustment-amount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">

							</div>
							<div class="summary-column">
								<label>今回繰越額</label>
								<input type="text" id="bh-carry-forward" readonly>
							</div>

							<div class="summary-column">
								<label>今回運賃額</label>
								<input type="text" id="bh-freight-amount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
							</div>

							<div class="summary-double-column">

								<label>割増額(課)</label>
								<label>割増額(非)</label>
								<input type="text" id="bh-taxable-surcharge" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
								<input type="text" id="bh-nontaxable-surcharge" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">

							</div>

							<div class="summary-double-column">

								<label>課税値引額</label>
								<label>非課税値引</label>
								<input type="text" id="bh-taxable-discount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
								<input type="text" id="bh-nontaxable-discount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">

							</div>

							<div class="summary-column">
								<label>今回消費税</label>
								<input type="text" id="bh-consumption-tax" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
							</div>

							<div class="summary-column">
								<label>今回値引額</label>
								<input type="text" id="bh-discount-amount" readonly>
							</div>

							<div class="summary-column">
								<label>今回合計額</label>
								<input type="text" id="bh-total-amount" readonly>
							</div>

							<div class="summary-column">
								<label>今回請求額</label>
								<input type="text" id="bh-billing-amount" readonly>
							</div>

							<div class="payment-area">

								<label>回収予定日</label>

								<label>回収方法</label>

								<input type="text" id="bh-collection-date" class="date-input jp-calendar-input first-year-display collection" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日">

								<div class="paymentMethod-input">
									<input type="text" id="collectionMethod3-code" class="input-sl">

									<select id="collectionMethod3-name" class="master-name" tabindex="-1">
										<option value=""></option>
										@foreach (var item in ViewBag.PaymentCategories)
										{
											<option value="@item.入金区分コード">
												@item.入金区分名称
											</option>
										}
									</select>
								</div>

							</div>

						</div>

						<!-- Action Buttons -->
						<div class="action-button-row">
							<button type="button" id="bh_EditBtn">
								↓ 修　正
							</button>
							<button type="button" id="bh_CallBtn">
								↑ 呼　出
							</button>
							<button type="button" id="bh_DelBtn" disabled>
								削　除
							</button>
							<button type="button" id="bh_CancelBtn">
								中　止
							</button>
						</div>
						<!-- Grid -->
						<div class="history-grid-wrapper">
							<table class="history-grid" data-grid-columns>
								<thead>
									<tr>
										<th>開始日</th>
										<th>終了日</th>
										<th>前回請求額</th>
										<th>今回入金額</th>
										<th>入金調整額</th>
										<th>今回繰越額</th>
										<th>今回運賃額</th>
										<th>割増額(課)</th>
										<th>割増額(非)</th>
										<th>課税値引額</th>
										<th>非課税値引</th>
										<th>今回消費税</th>
										<th>今回値引額</th>
										<th>今回合計額</th>
										<th>今回請求額</th>
										<th>回収予定日</th>
										<th>回収方法</th>
									</tr>
								</thead>
								<tbody>
								</tbody>
							</table>
						</div>
					</div>
				</section>
				<!--Accounts Receivable History-->
				<section id="accountsReceivableHistory" class="tab-content">
					<div id="ar_HistoryDetails" class="tab-details history-tab">
						<div class="branchTarget-header-row">
							<div class="master-row branch">
								<label>
									自社支店
								</label>
								<input type="text" id="branch-code2" class="input-sl" value=@ViewBag.BranchCode>

								<input type="text" id="ar-branch-name" value=@ViewBag.BranchName readonly="">
							</div>
							<div class="history-top-area">
								<div class="period-row">
									<label class="period-label">対象期間</label>
									<input type="text" id="fromDate_Ar" class="date-input jp-calendar-input first-year-display" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日">
									<span class="between-date">～</span>
									<input type="text" id="toDate_Ar" class="date-input jp-calendar-input first-year-display" data-show-day="true" data-no-era="false" placeholder="__ __年__月__日">
								</div>
							</div>
						</div>
						<div class="billing-summary-layout">

							<div class="summary-column">
								<label>前月売掛残</label>
								<input type="text" id="ar-previous-balance" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
							</div>

							<div class="summary-double-column">

								<label>今月入金額</label>
								<label>入金調整額</label>
								<input type="text" id="ar-payment-amount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
								<input type="text" id="ar-adjustment-amount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">

							</div>
							<div class="summary-column">
								<label>今月繰越額</label>
								<input type="text" id="ar-carry-forward" readonly>
							</div>

							<div class="summary-column">
								<label>今月運賃額</label>
								<input type="text" id="ar-freight-amount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
							</div>

							<div class="summary-double-column">

								<label>割増額(課)</label>
								<label>割増額(非)</label>
								<input type="text" id="ar-taxable-surcharge" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
								<input type="text" id="ar-nontaxable-surcharge" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">

							</div>

							<div class="summary-double-column">

								<label>課税値引額</label>
								<label>非課税値引</label>
								<input type="text" id="ar-taxable-discount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
								<input type="text" id="ar-nontaxable-discount" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">

							</div>

							<div class="summary-column">
								<label>今月消費税</label>
								<input type="text" id="ar-consumption-tax" class="decimal-input" data-int-digits="9" data-dec-digits="0" data-allow-negative="true" data-max-value="999,999,999">
							</div>

							<div class="summary-column">
								<label>今月値引額</label>
								<input type="text" id="ar-discount-amount" readonly>
							</div>

							<div class="summary-column">
								<label>今月合計額</label>
								<input type="text" id="ar-total-amount" readonly>
							</div>

							<div class="summary-column">
								<label>今月売掛残</label>
								<input type="text" id="ar-receivable-balance" readonly>
							</div>
						</div>

						<!-- Action Buttons -->
						<div class="action-button-row">
							<button type="button" id="ar_EditBtn">
								↓ 修　正
							</button>
							<button type="button" id="ar_CallBtn">
								↑ 呼　出
							</button>
							<button type="button" id="ar_DelBtn" disabled>
								削　除
							</button>
							<button type="button" id="ar_CancelBtn">
								中　止
							</button>
						</div>
						<!-- Grid -->
						<div class="history-grid-wrapper">
							<table class="history-grid" data-grid-columns>
								<thead>
									<tr>
										<th>開始日</th>
										<th>終了日</th>
										<th>前月売掛残</th>
										<th>今月入金額</th>
										<th>入金調整額</th>
										<th>今月繰越額</th>
										<th>今月運賃額</th>
										<th>割増額(課)</th>
										<th>割増額(非)</th>
										<th>課税値引額</th>
										<th>非課税値引</th>
										<th>今月消費税</th>
										<th>今月値引額</th>
										<th>今月合計額</th>
										<th>今月売掛残</th>
									</tr>
								</thead>
								<tbody>
								</tbody>
							</table>
						</div>
					</div>
				</section>

				<section id="payrollOptionSettings" class="tab-content">
					<div class="tab-row">
						<label>手当掛率</label>
						<div>
							<input type="text" value="100.00" id="payrollOptInp" class="decimal-input" data-int-digits="3" data-dec-digits="2" data-max-value="100.00">
							<span id="percentage" class="input-span">％</span>
						</div>
					</div>
				</section>

				<section id="digitacoSetting" class="tab-content">
					<div class="tab-row">
						<label>ﾃﾞｼﾞﾀｺｺｰﾄﾞ</label>
						<input type="text" id="digitaco">
					</div>
				</section>
			</section>
		</section>
	</main>
	<!-- Message Area -->
	<section class="message-area">
		<label>メッセージ：</label>
		<span id="message-label"></span>
	</section>

	<!-- Footer Function Keys -->
	<footer class="function-footer">

		<button type="button" id="btnRegister">
			F1:登録
		</button>

		<button type="button" id="btnCopy" disabled>
			F2:コピー
		</button>

		<button type="button" disabled>
			F3:　　
		</button>

		<button type="button" id="btnDelete" disabled>
			F4:削　除
		</button>

		<button type="button" id="btnSearch">
			F5:検　索
		</button>

		<button type="button" id="btnMasterSearch" disabled>
			F6:マスタ検索
		</button>

		<button type="button" id="btnPrevious">
			F7:≪　前
		</button>

		<button type="button" id="btnNext">
			F8:次　≫
		</button>

		<button type="button" id="btnList" disabled>
			F9:リスト
		</button>

		<button type="button" disabled>
			F10:　　
		</button>

		<button type="button" id="btnCancel">
			F11:中 止
		</button>

		<button type="button" id="btnExit" data-exit-url="@Url.Action("Main_menu", "MainMenu")">
			F12:終 了
		</button>

	</footer>
</div>
